generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  WELLBEING
  TEAM_LEAD
  AUDITOR
  EMPLOYEE
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum SignalSource {
  TEXT
  WORKLOAD
  FACIAL_PREMIUM
}

enum RiskLevel {
  LOW
  OBSERVATION
  PREVENTIVE_ATTENTION
  HIGH
}

enum AlertStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  industry      String?
  premiumFacial Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teams     Team[]
  users     User[]
  messages  Message[]
  alerts    PreventiveAlert[]
  auditLogs AuditLog[]
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      User[]
  messages     Message[]
  alerts       PreventiveAlert[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  teamId         String?
  email          String    @unique
  name           String
  role           UserRole  @default(EMPLOYEE)
  passwordHash   String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  consents     Consent[]
  messages     Message[]
  analyses     MessageAnalysis[]
  auditLogs    AuditLog[]
  alertsOpened PreventiveAlert[] @relation("AlertOpenedBy")

  @@index([organizationId])
  @@index([teamId])
  @@index([role])
}

model Consent {
  id        String        @id @default(cuid())
  userId    String
  source    SignalSource
  status    ConsentStatus @default(PENDING)
  grantedAt DateTime?
  revokedAt DateTime?
  expiresAt DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([status])
}

model Message {
  id              String       @id @default(cuid())
  organizationId  String
  teamId          String?
  authorId        String
  source          SignalSource @default(TEXT)
  contentHash     String
  redactedPreview String?
  sentAt          DateTime
  createdAt       DateTime     @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  analyses     MessageAnalysis[]

  @@index([organizationId, sentAt])
  @@index([teamId, sentAt])
  @@index([authorId, sentAt])
}

model MessageAnalysis {
  id         String    @id @default(cuid())
  messageId  String
  userId     String?
  score      Int
  level      RiskLevel
  confidence Int
  signals    Json
  modelName  String    @default("rules-mvp")
  createdAt  DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([createdAt])
}

model PreventiveAlert {
  id                String      @id @default(cuid())
  organizationId    String
  teamId            String?
  openedById        String?
  title             String
  summary           String
  level             RiskLevel
  status            AlertStatus @default(OPEN)
  recommendedAction String
  createdAt         DateTime    @default(now())
  resolvedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  openedBy     User?        @relation("AlertOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([teamId, status])
  @@index([level])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
