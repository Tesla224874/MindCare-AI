generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  WELLBEING
  TEAM_LEAD
  AUDITOR
  EMPLOYEE
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum SignalSource {
  TEXT
  WORKLOAD
  FACIAL_PREMIUM
}

enum RiskLevel {
  LOW
  OBSERVATION
  PREVENTIVE_ATTENTION
  HIGH
}

enum AlertStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum CaseStatus {
  TRIAGE
  ACTIVE
  MONITORING
  ESCALATED
  CLOSED
}

enum CasePriority {
  LOW
  STANDARD
  HIGH
  URGENT
}

enum CaseActionType {
  HUMAN_REVIEW
  WELLBEING_CHECKIN
  WORKLOAD_ADJUSTMENT
  MANAGER_ALIGNMENT
  CONSENT_REVIEW
  EXTERNAL_REFERRAL
  CASE_CLOSED
}

enum CaseNoteVisibility {
  INTERNAL
  AUDIT_ONLY
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  industry      String?
  premiumFacial Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teams     Team[]
  users     User[]
  messages  Message[]
  alerts    PreventiveAlert[]
  cases     InterventionCase[]
  auditLogs AuditLog[]
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      User[]
  messages     Message[]
  alerts       PreventiveAlert[]
  cases        InterventionCase[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  teamId         String?
  email          String    @unique
  name           String
  role           UserRole  @default(EMPLOYEE)
  passwordHash   String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  consents     Consent[]
  messages     Message[]
  analyses     MessageAnalysis[]
  auditLogs    AuditLog[]
  alertsOpened PreventiveAlert[]  @relation("AlertOpenedBy")
  casesOwned   InterventionCase[] @relation("CaseOwner")
  casesSubject InterventionCase[] @relation("CaseSubject")
  caseNotes    CaseNote[]
  caseActions  CaseAction[]

  @@index([organizationId])
  @@index([teamId])
  @@index([role])
}

model Consent {
  id        String        @id @default(cuid())
  userId    String
  source    SignalSource
  status    ConsentStatus @default(PENDING)
  grantedAt DateTime?
  revokedAt DateTime?
  expiresAt DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source])
  @@index([status])
}

model Message {
  id              String       @id @default(cuid())
  organizationId  String
  teamId          String?
  authorId        String
  source          SignalSource @default(TEXT)
  contentHash     String
  redactedPreview String?
  sentAt          DateTime
  createdAt       DateTime     @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  analyses     MessageAnalysis[]

  @@index([organizationId, sentAt])
  @@index([teamId, sentAt])
  @@index([authorId, sentAt])
}

model MessageAnalysis {
  id         String    @id @default(cuid())
  messageId  String
  userId     String?
  score      Int
  level      RiskLevel
  confidence Int
  signals    Json
  modelName  String    @default("rules-mvp")
  createdAt  DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([createdAt])
}

model PreventiveAlert {
  id                String      @id @default(cuid())
  organizationId    String
  teamId            String?
  openedById        String?
  title             String
  summary           String
  level             RiskLevel
  status            AlertStatus @default(OPEN)
  recommendedAction String
  createdAt         DateTime    @default(now())
  resolvedAt        DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  openedBy     User?             @relation("AlertOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  case         InterventionCase?

  @@index([organizationId, status])
  @@index([teamId, status])
  @@index([level])
}

model InterventionCase {
  id             String       @id @default(cuid())
  organizationId String
  alertId        String?      @unique
  teamId         String?
  subjectUserId  String?
  ownerId        String?
  title          String
  summary        String
  objective      String
  nextStep       String
  status         CaseStatus   @default(TRIAGE)
  priority       CasePriority @default(STANDARD)
  dueAt          DateTime?
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alert        PreventiveAlert? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  subjectUser  User?            @relation("CaseSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  owner        User?            @relation("CaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  notes        CaseNote[]
  actions      CaseAction[]

  @@index([organizationId, status])
  @@index([teamId, status])
  @@index([ownerId, status])
  @@index([priority])
  @@index([dueAt])
}

model CaseNote {
  id         String             @id @default(cuid())
  caseId     String
  authorId   String?
  body       String
  visibility CaseNoteVisibility @default(INTERNAL)
  createdAt  DateTime           @default(now())

  case   InterventionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([authorId, createdAt])
}

model CaseAction {
  id          String         @id @default(cuid())
  caseId      String
  actorId     String?
  type        CaseActionType
  description String
  metadata    Json?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  case  InterventionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
  @@index([type])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
